# Runtime
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8001
HTTP_PORT=80
AWS_REGION=us-east-1
CORS_ORIGINS=http://localhost,http://127.0.0.1

# Replace with a unique random value of at least 32 characters before production.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Persistent storage paths are set by docker-compose.yml.
DATABASE_PATH=/app/backend/data/shopmart.db

# Jira Cloud (leave integration credentials empty until configured)
JIRA_INSTANCE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=KAN

# Confluence Cloud
CONFLUENCE_BASE_URL=https://your-domain.atlassian.net/wiki
CONFLUENCE_EMAIL=
CONFLUENCE_API_KEY=
CONFLUENCE_SPACE_KEY=SELFHELP

# AWS Bedrock uses the EC2 instance role in production; do not store AWS keys here.

# MeshCentral
MESHCENTRAL_URL=wss://your-meshcentral-host:443
MESHCENTRAL_USER=
MESHCENTRAL_PASS=
MESHCTRL_PATH=
